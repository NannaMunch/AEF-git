    "# ------------------------------------------------------------\n",
    "# Average realized variance and estimation uncertainty\n",
    "# ------------------------------------------------------------\n",
    "rv_summary = (\n",
    "    rv_all\n",
    "    .groupby(\"sampling_minutes\")\n",
    "    .agg(\n",
    "        mean_rv=(\"realized_variance\", \"mean\"),\n",
