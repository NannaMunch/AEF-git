    "## Exercise 5\n",
    "\n",
    "We evaluate the three portfolio strategies out of sample over the same evaluation window as in Exercise 3. For each day (t), we apply the portfolio weights estimated using information available up to day (t-1) to the realized close-to-close return vector on day (t). This gives realized out-of-sample portfolio returns for the high-frequency minimum-variance strategy, the Ledoit-Wolf minimum-variance strategy, and an equal-weighted benchmark.\n",
    "\n",
    "For a given strategy with weights (\\omega_t), the realized portfolio return is computed as\n",
    "\n",
    "$$\n",
    "r_{p,t} = \\omega_t' r_t,\n",
    "$$\n",
    "\n",
    "where ($r_t$) is the vector of realized daily close-to-close log returns on day (t). We report annualized portfolio volatility and annualized Sharpe ratios, assuming a zero risk-free rate."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 29,
   "id": "c1a81540",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ------------------------------------------------------------\n",
    "# Exercise 5: Out-of-sample portfolio returns\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "# Convert daily return index to datetime to match weights\n",
    "daily_returns_eval = daily_returns.copy()\n",
    "daily_returns_eval.index = pd.to_datetime(daily_returns_eval.index)\n",
    "\n",
    "# Trading days where portfolio weights are available\n",
    "weight_days = (\n",
    "    weights_long[\"trading_day\"]\n",
    "    .drop_duplicates()\n",
    "    .sort_values()\n",
    ")\n",
    "\n",
    "# Use only days where we have both weights and realized daily returns\n",
    "oos_days = sorted(\n",
    "    set(weight_days).intersection(set(daily_returns_eval.index))\n",
    ")\n",
    "\n",
    "# Keep returns for the relevant stocks and evaluation days\n",
    "daily_returns_oos = daily_returns_eval.loc[oos_days, symbols].copy()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 30,
   "id": "3702bcab",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Construct realized out-of-sample portfolio returns\n",
    "portfolio_return_data = []\n",
    "\n",
    "# Equal-weight vector\n",
    "n_stocks = len(symbols)\n",
    "equal_weights = np.repeat(1 / n_stocks, n_stocks)\n",
    "\n",
    "for trading_day in oos_days:\n",
    "    \n",
    "    # Realized daily close-to-close return vector on day t\n",
    "    realized_return = daily_returns_oos.loc[trading_day, symbols].to_numpy()\n",
    "    \n",
    "    # High-frequency and Ledoit-Wolf minimum-variance strategies\n",
    "    for strategy in [\"HF\", \"LW\"]:\n",
    "        \n",
    "        weights_t = (\n",
    "            weights_wide\n",
    "            .loc[(strategy, trading_day), symbols]\n",
    "            .to_numpy()\n",
    "        )\n",
    "        \n",
    "        portfolio_return_data.append({\n",
    "            \"trading_day\": trading_day,\n",
    "            \"strategy\": strategy,\n",
    "            \"portfolio_return\": weights_t @ realized_return\n",
    "        })\n",
    "    \n",
    "    # Equal-weighted benchmark\n",
    "    portfolio_return_data.append({\n",
    "        \"trading_day\": trading_day,\n",
    "        \"strategy\": \"Equal-weighted\",\n",
    "        \"portfolio_return\": equal_weights @ realized_return\n",
    "    })\n",
    "\n",
    "portfolio_returns = pd.DataFrame(portfolio_return_data)\n",
    "portfolio_returns[\"trading_day\"] = pd.to_datetime(portfolio_returns[\"trading_day\"])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 31,
   "id": "db86f674",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Annualized volatility and Sharpe ratio\n",
    "TRADING_DAYS_PER_YEAR = 252\n",
    "\n",
    "performance_summary = (\n",
    "    portfolio_returns\n",
    "    .groupby(\"strategy\")\n",
    "    .agg(\n",
    "        mean_daily_return=(\"portfolio_return\", \"mean\"),\n",
    "        daily_volatility=(\"portfolio_return\", \"std\"),\n",
    "        n_days=(\"portfolio_return\", \"count\")\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "performance_summary[\"annualized_return\"] = (\n",
    "    TRADING_DAYS_PER_YEAR * performance_summary[\"mean_daily_return\"]\n",
    ")\n",
    "\n",
    "performance_summary[\"annualized_volatility\"] = (\n",
    "    np.sqrt(TRADING_DAYS_PER_YEAR) * performance_summary[\"daily_volatility\"]\n",
    ")\n",
    "\n",
    "performance_summary[\"annualized_sharpe\"] = (\n",
    "    performance_summary[\"annualized_return\"]\n",
    "    / performance_summary[\"annualized_volatility\"]\n",
    ")\n",
    "\n",
    "performance_summary[\"annualized_return_percent\"] = (\n",
    "    100 * performance_summary[\"annualized_return\"]\n",
    ")\n",
    "\n",
    "performance_summary[\"annualized_volatility_percent\"] = (\n",
    "    100 * performance_summary[\"annualized_volatility\"]\n",
    ")"
   ]
  },
