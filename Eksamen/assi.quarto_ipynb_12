        "# ------------------------------------------------------------\n",
        "# 2. Keep AAPL only and sort by timestamp\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "# Exercise 1 is only about AAPL\n",
        "aapl_raw = (\n",
        "    hf_prices\n",
        "    .query(\"symbol == 'AAPL'\")\n",
