    "# ------------------------------------------------------------\n",
    "# 9. Compute average realized variance and estimation uncertainty\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "# For each sampling interval, average daily realized variance across all trading days\n",
    "rv_summary = (\n",
    "    rv_all\n",
    "    .groupby(\"sampling_minutes\")\n",
    "    .agg(\n",
    "        mean_rv=(\"realized_variance\", \"mean\"),\n",
    "        sd_rv=(\"realized_variance\", \"std\"),\n",
    "        n_days=(\"realized_variance\", \"count\")\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "# Standard error of the mean realized variance\n",
    "# This measures estimation uncertainty around the average RV estimate\n",
    "rv_summary[\"se_rv\"] = rv_summary[\"sd_rv\"] / np.sqrt(rv_summary[\"n_days\"])\n",
    "\n",
    "# Approximate 95 percent confidence interval\n",
    "rv_summary[\"ci_lower\"] = rv_summary[\"mean_rv\"] - 1.96 * rv_summary[\"se_rv\"]\n",
    "rv_summary[\"ci_upper\"] = rv_summary[\"mean_rv\"] + 1.96 * rv_summary[\"se_rv\"]\n",
    "\n",
    "print(\"Average realized variance by sampling interval:\")\n",
    "print(rv_summary)"
   ]
