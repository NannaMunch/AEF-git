    "# ------------------------------------------------------------\n",
    "# 5. Function to compute daily realized variance\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "def compute_daily_rv(data, sampling_minutes):\n",
    "    \"\"\"\n",
    "    Compute daily realized variance for a given sampling interval.\n",
    "\n",
    "    Sampling is based on timestamps relative to the fixed market open at 09:30.\n",
    "    For example:\n",
    "    - 5-minute sampling keeps 09:30, 09:35, 09:40, ...\n",
    "    - 30-minute sampling keeps 09:30, 10:00, 10:30, ...\n",
    "    - 60-minute sampling keeps 09:30, 10:30, 11:30, ...\n",
    "\n",
    "    The first return of each day is NaN because there is no previous sampled\n",
    "    price within the same trading day.\n",
    "    \"\"\"\n",
    "    \n",
    "    sampled = data.sort_values([\"trading_day\", \"ts\"]).copy()\n",
    "\n",
    "    # Fixed market open for each row\n",
    "    market_open = pd.to_datetime(\n",
    "        sampled[\"trading_day\"].astype(str) + \" 09:30:00\"\n",
    "    )\n",
    "\n",
    "    # Minutes since fixed market open\n",
    "    sampled[\"minutes_since_open\"] = (\n",
    "        (sampled[\"ts\"] - market_open)\n",
    "        .dt.total_seconds()\n",
    "        / 60\n",
    "    ).round().astype(int)\n",
    "\n",
    "    # Keep observations on the Delta-minute grid\n",
    "    sampled = sampled[\n",
    "        sampled[\"minutes_since_open\"] % sampling_minutes == 0\n",
    "    ].copy()\n",
    "\n",
    "    # Compute intraday log returns within each trading day\n",
    "    sampled[\"intraday_return\"] = (\n",
    "        sampled\n",
    "        .groupby(\"trading_day\")[\"log_price\"]\n",
    "        .diff()\n",
    "    )\n",
    "\n",
    "    # Daily realized variance = sum of squared intraday log returns\n",
    "    rv_daily = (\n",
    "        sampled\n",
    "        .groupby(\"trading_day\")\n",
    "        .agg(\n",
    "            realized_variance=(\n",
    "                \"intraday_return\",\n",
    "                lambda x: np.nansum(x ** 2)\n",
    "            ),\n",
    "            n_returns=(\n",
    "                \"intraday_return\",\n",
    "                lambda x: x.notna().sum()\n",
    "            )\n",
    "        )\n",
    "        .reset_index()\n",
    "    )\n",
    "\n",
    "    rv_daily[\"sampling_minutes\"] = sampling_minutes\n",
    "\n",
    "    return rv_daily"
   ]
