    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Compute daily realized covariance matrices\n",
        "\n",
        "def compute_daily_rcov(group_day):\n",
        "    \"\"\"\n",
        "    Compute the 30x30 realized covariance matrix for one trading day.\n",
        "    \n",
        "    The group contains all 30 stocks on a synchronized 5-minute grid.\n",
        "    \"\"\"\n",
        "    \n",
        "    trading_day = group_day[\"trading_day\"].iloc[0]\n",
        "    \n",
        "    # Pivot to wide format: rows = time steps, columns = stocks\n",
        "    prices_wide = group_day.pivot_table(\n",
        "        index=\"ts\",\n",
        "        columns=\"symbol\",\n",
        "        values=\"log_price\",\n",
        "        aggfunc=\"first\"\n",
        "    )\n",
        "    \n",
        "    # Compute log-returns\n",
        "    returns_wide = prices_wide.diff().dropna()\n",
        "    \n",
        "    if len(returns_wide) < 2:\n",
        "        return None\n",
        "    \n",
        "    # Compute covariance matrix\n",
        "    try:\n",
        "        rcov_matrix = np.cov(returns_wide.values.T, ddof=1)\n",
        "        \n",
        "        return {\n",
        "            \"trading_day\": trading_day,\n",
        "            \"rcov_matrix\": rcov_matrix,\n",
        "            \"n_obs\": len(returns_wide),\n",
        "            \"stocks\": returns_wide.columns.tolist()\n",
        "        }\n",
        "    except:\n",
        "        return None\n",
        "\n",
        "# Compute RC matrix for each trading day\n",
        "rcov_results = []\n",
        "\n",
        "for trading_day, group_day in all_minute_5min.groupby(\"trading_day\"):\n",
