        "# --------------------------------------------------------\n",
        "# 2. Keep AAPL only and prepare time variables\n",
        "# --------------------------------------------------------\n",
        "\n",
        "aapl_raw = (\n",
        "    hf_prices\n",
        "    .query(\"symbol == 'AAPL'\")\n",
        "    .copy()\n",
        ")\n",
        "\n",
        "aapl_raw[\"ts\"] = pd.to_datetime(aapl_raw[\"ts\"])\n",
        "aapl_raw[\"trading_day\"] = aapl_raw[\"ts\"].dt.date\n",
        "aapl_raw[\"log_price\"] = np.log(aapl_raw[\"price\"])\n",
        "\n",
        "aapl_raw = aapl_raw.sort_values([\"trading_day\", \"ts\"])\n",
        "\n",
        "# Check number of observations per day\n",
        "day_check = (\n",
        "    aapl_raw\n",
        "    .groupby(\"trading_day\")\n",
        "    .size()\n",
        "    .rename(\"n_minutes\")\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "print(day_check[\"n_minutes\"].describe())"
