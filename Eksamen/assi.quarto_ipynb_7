      "source": [
        "hf_prices = pd.read_parquet(\"/Users/AstridMoeller/AEF/data/hf_minute_prices.parquet\")\n",
        "\n",
        "hf_prices[\"ts\"] = pd.to_datetime(hf_prices[\"ts\"])\n",
