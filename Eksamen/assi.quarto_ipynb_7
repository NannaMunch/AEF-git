    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "aapl_raw = (\n",
        "    hf_prices\n",
        "    .query(\"symbol == 'AAPL'\")\n",
        "    .copy()\n",
        ")\n",
        "\n",
        "n_trading_days_aapl = aapl_raw[\"trading_day\"].nunique()\n",
        "print(n_trading_days_aapl)"
      ],
      "id": "eb0f9de3",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "aapl_raw = (\n",
        "    aapl_raw\n",
        "    .sort_values([\"trading_day\", \"ts\"])\n",
        "    .copy()\n",
        ")\n",
        "\n",
        "aapl_raw[\"log_price\"] = np.log(aapl_raw[\"price\"])"
      ],
      "id": "b2884698",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def missing_minutes_one_day(group):\n",
        "    full_grid = pd.date_range(\n",
        "        start=group[\"ts\"].min(),\n",
        "        end=group[\"ts\"].max(),\n",
        "        freq=\"1min\"\n",
        "    )\n",
        "\n",
        "    observed_minutes = group[\"ts\"].drop_duplicates()\n",
        "\n",
        "    return pd.Series({\n",
        "        \"expected_minutes\": len(full_grid),\n",
        "        \"observed_minutes\": observed_minutes.nunique(),\n",
        "        \"missing_minutes\": len(full_grid) - observed_minutes.nunique(),\n",
        "        \"missing_share\": (\n",
        "            len(full_grid) - observed_minutes.nunique()\n",
        "        ) / len(full_grid)\n",
        "    })\n",
        "\n",
        "aapl_missing_by_day = (\n",
        "    aapl_raw\n",
        "    .groupby(\"trading_day\")\n",
        "    .apply(missing_minutes_one_day)\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "print(aapl_missing_by_day.describe())"
      ],
      "id": "bfa0bbd5",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def complete_one_day(group):\n",
        "    group = group.sort_values(\"ts\").copy()\n",
        "\n",
        "    full_index = pd.date_range(\n",
        "        start=group[\"ts\"].min(),\n",
        "        end=group[\"ts\"].max(),\n",
        "        freq=\"1min\"\n",
        "    )\n",
        "\n",
        "    group = group.set_index(\"ts\").reindex(full_index)\n",
        "    group.index.name = \"ts\"\n",
        "\n",
        "    group[\"symbol\"] = \"AAPL\"\n",
        "    group[\"trading_day\"] = group.index.date\n",
        "    group[\"price\"] = group[\"price\"].ffill()\n",
        "    group[\"log_price\"] = np.log(group[\"price\"])\n",
        "\n",
        "    return group.reset_index()\n",
        "\n",
        "aapl_minute = (\n",
        "    aapl_raw\n",
        "    .groupby(\"trading_day\", group_keys=False)\n",
        "    .apply(complete_one_day)\n",
        "    .dropna(subset=[\"price\"])\n",
        "    .sort_values([\"trading_day\", \"ts\"])\n",
        "    .reset_index(drop=True)\n",
        ")"
      ],
      "id": "ff00f36c",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def compute_daily_rv(data, sampling_minutes):\n",
        "    sampled = data.sort_values([\"trading_day\", \"ts\"]).copy()\n",
        "\n",
        "    sampled[\"obs_number\"] = sampled.groupby(\"trading_day\").cumcount()\n",
        "\n",
        "    sampled = sampled[\n",
        "        sampled[\"obs_number\"] % sampling_minutes == 0\n",
        "    ].copy()\n",
        "\n",
        "    sampled[\"intraday_return\"] = (\n",
        "        sampled\n",
        "        .groupby(\"trading_day\")[\"log_price\"]\n",
        "        .diff()\n",
        "    )\n",
        "\n",
        "    rv_daily = (\n",
        "        sampled\n",
        "        .groupby(\"trading_day\")\n",
        "        .agg(\n",
        "            realized_variance=(\n",
        "                \"intraday_return\",\n",
        "                lambda x: np.nansum(x ** 2)\n",
        "            ),\n",
        "            n_returns=(\n",
        "                \"intraday_return\",\n",
        "                lambda x: x.notna().sum()\n",
        "            )\n",
        "        )\n",
        "        .reset_index()\n",
        "    )\n",
        "\n",
        "    rv_daily[\"sampling_minutes\"] = sampling_minutes\n",
        "\n",
        "    return rv_daily"
      ],
      "id": "09e972d4",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "sampling_intervals = [1, 2, 5, 10, 15, 30, 60]\n",
        "\n",
        "rv_all = pd.concat(\n",
        "    [\n",
        "        compute_daily_rv(aapl_minute, interval)\n",
        "        for interval in sampling_intervals\n",
        "    ],\n",
        "    ignore_index=True\n",
        ")"
      ],
      "id": "57e96bee",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "rv_summary = (\n",
        "    rv_all\n",
        "    .groupby(\"sampling_minutes\")\n",
        "    .agg(\n",
        "        mean_rv=(\"realized_variance\", \"mean\"),\n",
        "        sd_rv=(\"realized_variance\", \"std\"),\n",
        "        n_days=(\"realized_variance\", \"count\")\n",
        "    )\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "rv_summary[\"se_rv\"] = rv_summary[\"sd_rv\"] / np.sqrt(rv_summary[\"n_days\"])\n",
        "rv_summary[\"ci_lower\"] = rv_summary[\"mean_rv\"] - 1.96 * rv_summary[\"se_rv\"]\n",
        "rv_summary[\"ci_upper\"] = rv_summary[\"mean_rv\"] + 1.96 * rv_summary[\"se_rv\"]\n",
        "\n",
        "print(rv_summary)"
      ],
