        "# Annualized volatility and Sharpe ratio\n",
        "TRADING_DAYS_PER_YEAR = 252\n",
        "\n",
        "performance_summary = (\n",
        "    portfolio_returns\n",
        "    .groupby(\"strategy\")\n",
        "    .agg(\n",
        "        mean_daily_return=(\"portfolio_return\", \"mean\"),\n",
        "        daily_volatility=(\"portfolio_return\", \"std\"),\n",
        "        n_days=(\"portfolio_return\", \"count\")\n",
        "    )\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "performance_summary[\"annualized_return\"] = (\n",
        "    TRADING_DAYS_PER_YEAR * performance_summary[\"mean_daily_return\"]\n",
        ")\n",
        "\n",
        "performance_summary[\"annualized_volatility\"] = (\n",
        "    np.sqrt(TRADING_DAYS_PER_YEAR) * performance_summary[\"daily_volatility\"]\n",
        ")\n",
        "\n",
        "performance_summary[\"annualized_sharpe\"] = (\n",
        "    performance_summary[\"annualized_return\"]\n",
        "    / performance_summary[\"annualized_volatility\"]\n",
        ")\n",
        "\n",
        "performance_summary[\"annualized_return_percent\"] = (\n",
        "    100 * performance_summary[\"annualized_return\"]\n",
        ")\n",
        "\n",
        "performance_summary[\"annualized_volatility_percent\"] = (\n",
        "    100 * performance_summary[\"annualized_volatility\"]\n",
        ")"
