      "source": [
        "# Construct realized out-of-sample portfolio returns\n",
        "portfolio_return_data = []\n",
        "\n",
        "# Equal-weight vector\n",
        "n_stocks = len(symbols)\n",
        "equal_weights = np.repeat(1 / n_stocks, n_stocks)\n",
        "\n",
        "# Convert log returns to simple returns for the realized portfolio return.\n",
        "# A portfolio return is a weighted average of SIMPLE returns; this matters most\n",
        "# for the high-leverage HF weights.\n",
        "simple_returns_oos = np.expm1(daily_returns_oos)\n",
        "\n",
        "for trading_day in oos_days:\n",
        "    \n",
        "    # Realized daily close-to-close SIMPLE return vector on day t\n",
        "    realized_simple = simple_returns_oos.loc[trading_day, symbols].to_numpy()\n",
        "    \n",
        "    # High-frequency and Ledoit-Wolf minimum-variance strategies\n",
        "    for strategy in [\"HF\", \"LW\"]:\n",
        "        \n",
        "        weights_t = (\n",
        "            weights_wide\n",
        "            .loc[(strategy, trading_day), symbols]\n",
        "            .to_numpy()\n",
        "        )\n",
        "        \n",
        "        portfolio_return_data.append({\n",
        "            \"trading_day\": trading_day,\n",
        "            \"strategy\": strategy,\n",
        "            \"portfolio_return\": weights_t @ realized_simple\n",
        "        })\n",
        "    \n",
        "    # Equal-weighted benchmark\n",
        "    portfolio_return_data.append({\n",
        "        \"trading_day\": trading_day,\n",
        "        \"strategy\": \"EW\",\n",
        "        \"portfolio_return\": equal_weights @ realized_simple\n",
        "    })\n",
        "\n",
        "portfolio_returns = pd.DataFrame(portfolio_return_data)\n",
        "portfolio_returns[\"trading_day\"] = pd.to_datetime(portfolio_returns[\"trading_day\"])"
      ],
