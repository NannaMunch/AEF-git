        "# ------------------------------------------------------------\n",
        "# Exercise 4: Minimum-variance portfolio weights\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def minimum_variance_weights(cov_matrix):\n",
        "    \"\"\"\n",
        "    Compute unconstrained minimum-variance portfolio weights.\n",
        "\n",
        "    The portfolio solves:\n",
        "        min w' Sigma w\n",
        "        subject to iota'w = 1\n",
        "\n",
        "    Closed-form solution:\n",
        "        w = Sigma^{-1} iota / (iota' Sigma^{-1} iota)\n",
        "    \"\"\"\n",
        "    \n",
        "    sigma = np.asarray(cov_matrix, dtype=float)\n",
        "    iota = np.ones(sigma.shape[0])\n",
        "    \n",
        "    # Symmetrize to avoid tiny numerical asymmetries\n",
        "    sigma = 0.5 * (sigma + sigma.T)\n",
        "    \n",
        "    try:\n",
        "        sigma_inv_iota = np.linalg.solve(sigma, iota)\n",
        "    except np.linalg.LinAlgError:\n",
        "        # Fallback if the covariance matrix is singular or ill-conditioned\n",
        "        sigma_inv_iota = np.linalg.pinv(sigma) @ iota\n",
        "    \n",
        "    weights = sigma_inv_iota / (iota @ sigma_inv_iota)\n",
        "    \n",
        "    return weights"
      ],
