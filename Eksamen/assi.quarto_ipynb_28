        "# ------------------------------------------------------------\n",
        "# Exercise 5: Out-of-sample portfolio returns\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "# Convert daily return index to datetime to match weights\n",
        "daily_returns_eval = daily_returns.copy()\n",
        "daily_returns_eval.index = pd.to_datetime(daily_returns_eval.index)\n",
        "\n",
        "# Trading days where portfolio weights are available\n",
        "weight_days = (\n",
        "    weights_long[\"trading_day\"]\n",
        "    .drop_duplicates()\n",
        "    .sort_values()\n",
        ")\n",
        "\n",
        "# Use only days where we have both weights and realized daily returns\n",
        "oos_days = sorted(\n",
        "    set(weight_days).intersection(set(daily_returns_eval.index))\n",
        ")\n",
        "\n",
        "# Keep returns for the relevant stocks and evaluation days\n",
        "daily_returns_oos = daily_returns_eval.loc[oos_days, symbols].copy()"
      ],
