    "# ------------------------------------------------------------\n",
    "# 4. Create regular one-minute grid and forward-fill missing prices\n",
    "# ------------------------------------------------------------\n",
    "def complete_one_day(group):\n",
    "    \"\"\"\n",
    "    Create a fixed one-minute grid from 09:30 to 15:59 for one trading day\n",
    "    and forward-fill missing prices within that day only.\n",
    "\n",
    "    Important:\n",
    "    - Prices are never carried forward across trading days.\n",
    "    - We do not backfill prices before the first observed price of the day.\n",
    "    - The grid uses the same timezone as the original timestamp column.\n",
    "    \"\"\"\n",
    "    \n",
    "    group = group.sort_values(\"ts\").copy()\n",
    "    trading_day = group[\"trading_day\"].iloc[0]\n",
    "\n",
    "    market_open = market_timestamp(trading_day, MARKET_OPEN)\n",
    "    market_close = market_timestamp(trading_day, MARKET_CLOSE)\n",
    "\n",
    "    full_index = pd.date_range(\n",
    "        start=market_open,\n",
    "        end=market_close,\n",
    "        freq=\"1min\"\n",
    "    )\n",
    "\n",
    "    # Reindex one trading day to the fixed one-minute grid\n",
    "    group = group.set_index(\"ts\").reindex(full_index)\n",
    "    group.index.name = \"ts\"\n",
    "\n",
    "    # Reconstruct identifiers\n",
    "    group[\"symbol\"] = \"AAPL\"\n",
    "    group[\"trading_day\"] = group.index.date\n",
    "\n",
    "    # Forward-fill only within this trading day\n",
    "    # Early missing prices remain NaN because we do not backfill.\n",
    "    group[\"price\"] = group[\"price\"].ffill()\n",
    "\n",
    "    # Compute log price after filling\n",
    "    group[\"log_price\"] = np.log(group[\"price\"])\n",
    "\n",
    "    return group.reset_index()\n",
    "\n",
    "\n",
    "aapl_minute = (\n",
    "    aapl_raw\n",
    "    .groupby(\"trading_day\", group_keys=False)\n",
    "    .apply(complete_one_day)\n",
    "    .dropna(subset=[\"price\"])\n",
    "    .sort_values([\"trading_day\", \"ts\"])\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "print(\"AAPL data after constructing regular one-minute grid:\")\n",
    "print(aapl_minute.head())\n",
    "\n",
    "print(\"\\nNumber of rows before filling:\")\n",
    "print(len(aapl_raw))\n",
    "\n",
    "print(\"\\nNumber of rows after filling:\")\n",
    "print(len(aapl_minute))\n",
    "\n",
    "minute_check = (\n",
    "    aapl_minute\n",
    "    .groupby(\"trading_day\")\n",
    "    .size()\n",
    "    .rename(\"n_minutes_after_fill\")\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "print(\"\\nMinutes per trading day after forward-fill:\")\n",
    "print(minute_check[\"n_minutes_after_fill\"].describe())"
