        "# ------------------------------------------------------------\n",
        "# 3b. Ledoit-Wolf shrinkage estimator\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "# We use a rolling window of one trading year\n",
        "W = 252\n",
        "\n",
        "lw_covariances = {}\n",
        "lw_variance_data = []\n",
        "\n",
        "daily_return_days = list(daily_returns.index)\n",
        "\n",
        "for trading_day in evaluation_days:\n",
        "    \n",
        "    # The Ledoit-Wolf estimator requires daily returns up to t - 1.\n",
        "    # If the trading day is not in the daily-return index, skip it.\n",
        "    if trading_day not in daily_return_days:\n",
        "        continue\n",
        "    \n",
        "    pos = daily_return_days.index(trading_day)\n",
        "    \n",
        "    # Need at least W previous observations\n",
        "    if pos < W:\n",
        "        continue\n",
        "    \n",
        "    # Rolling window ending on day t - 1\n",
        "    window_returns = daily_returns.iloc[pos - W:pos]\n",
        "    \n",
        "    # Estimate Ledoit-Wolf covariance matrix\n",
        "    lw_model = LedoitWolf()\n",
        "    lw_model.fit(window_returns.values)\n",
        "    \n",
        "    sigma_lw = pd.DataFrame(\n",
        "        lw_model.covariance_,\n",
        "        index=symbols,\n",
        "        columns=symbols\n",
