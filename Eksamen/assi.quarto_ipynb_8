    "def missing_minutes_one_day(group):\n",
    "    full_grid = pd.date_range(\n",
    "        start=group[\"ts\"].min(),\n",
    "        end=group[\"ts\"].max(),\n",
    "        freq=\"1min\"\n",
    "    )\n",
    "\n",
    "    observed_minutes = group[\"ts\"].drop_duplicates()\n",
    "\n",
    "    return pd.Series({\n",
    "        \"expected_minutes\": len(full_grid),\n",
    "        \"observed_minutes\": observed_minutes.nunique(),\n",
    "        \"missing_minutes\": len(full_grid) - observed_minutes.nunique(),\n",
    "        \"missing_share\": (\n",
    "            len(full_grid) - observed_minutes.nunique()\n",
    "        ) / len(full_grid)\n",
    "    })\n",
    "\n",
    "aapl_missing_by_day = (\n",
    "    aapl_raw\n",
    "    .groupby(\"trading_day\")\n",
    "    .apply(missing_minutes_one_day)\n",
    "    .reset_index()\n",
    ")\n",
