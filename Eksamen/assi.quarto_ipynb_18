    "# ------------------------------------------------------------\n",
    "# 2. Keep AAPL only and sort by timestamp\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "aapl_raw = (\n",
    "    hf_prices\n",
    "    .query(\"symbol == 'AAPL'\")\n",
    "    .sort_values([\"trading_day\", \"ts\"])\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "# Compute log price\n",
    "# High-frequency realized variance is based on log returns\n",
    "aapl_raw[\"log_price\"] = np.log(aapl_raw[\"price\"])"
   ]
