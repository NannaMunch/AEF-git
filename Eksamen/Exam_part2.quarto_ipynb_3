      "source": [
        "# Average turnover between rebalances - so we find the change in weigths (average) between two trading days.\n",
        "turnover_data = []\n",
        "\n",
        "for strategy in [\"HF\", \"LW\"]:\n",
        "    \n",
        "    strategy_weights = (\n",
        "        weights_wide\n",
        "        .loc[strategy]\n",
        "        .sort_index()\n",
        "    )\n",
        "    \n",
        "    turnover_series = (\n",
        "        strategy_weights\n",
        "        .diff()\n",
        "        .abs()\n",
        "        .sum(axis=1)\n",
        "        .dropna()\n",
        "    )\n",
        "    \n",
        "    turnover_data.append({\n",
        "        \"strategy\": strategy,\n",
        "        \"average_turnover\": turnover_series.mean(),\n",
        "        \"median_turnover\": turnover_series.median(),\n",
        "        \"max_turnover\": turnover_series.max(),\n",
        "        \"n_rebalances\": turnover_series.shape[0]\n",
        "    })\n",
        "\n",
        "turnover_summary = pd.DataFrame(turnover_data)\n",
        "\n",
        "turnover_summary[\"average_turnover_percent\"] = (\n",
        "    100 * turnover_summary[\"average_turnover\"]\n",
        ")\n",
        "\n",
        "turnover_summary[\"median_turnover_percent\"] = (\n",
