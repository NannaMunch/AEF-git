    "# ------------------------------------------------------------\n",
    "# 5. Function to compute daily realized variance\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "def compute_daily_rv(data, sampling_minutes):\n",
    "    \"\"\"\n",
    "    Compute daily realized variance for a given sampling interval.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    data : pandas DataFrame\n",
    "        Data must contain trading_day, ts, and log_price.\n",
    "        \n",
    "    sampling_minutes : int\n",
    "        Sampling interval in minutes.\n",
    "        Example:\n",
    "        1  = use every minute\n",
    "        5  = use every fifth minute\n",
    "        60 = use every sixtieth minute\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    pandas DataFrame\n",
    "        One row per trading day with realized variance for the chosen interval.\n",
    "    \"\"\"\n",
    "    \n",
    "    # Sort data before sampling and computing returns\n",
    "    sampled = data.sort_values([\"trading_day\", \"ts\"]).copy()\n",
    "\n",
    "    # Create observation number within each trading day\n",
    "    # First observation of the day has obs_number = 0\n",
    "    sampled[\"obs_number\"] = sampled.groupby(\"trading_day\").cumcount()\n",
    "\n",
    "    # Keep every sampling_minutes-th observation within each day\n",
    "    # Example: if sampling_minutes = 5, we keep obs_number 0, 5, 10, 15, ...\n",
    "    sampled = sampled[\n",
    "        sampled[\"obs_number\"] % sampling_minutes == 0\n",
    "    ].copy()\n",
    "\n",
    "    # Compute intraday log returns within each trading day\n",
    "    # The first return of each day is NaN because there is no previous observation\n",
    "    sampled[\"intraday_return\"] = (\n",
    "        sampled\n",
    "        .groupby(\"trading_day\")[\"log_price\"]\n",
    "        .diff()\n",
    "    )\n",
    "\n",
    "    # Realized variance for each day:\n",
    "    # sum of squared intraday log returns\n",
    "    rv_daily = (\n",
    "        sampled\n",
    "        .groupby(\"trading_day\")\n",
    "        .agg(\n",
    "            realized_variance=(\n",
    "                \"intraday_return\",\n",
    "                lambda x: np.nansum(x ** 2)\n",
    "            ),\n",
    "            n_returns=(\n",
    "                \"intraday_return\",\n",
    "                lambda x: x.notna().sum()\n",
    "            )\n",
    "        )\n",
    "        .reset_index()\n",
    "    )\n",
    "\n",
    "    # Store sampling interval\n",
    "    rv_daily[\"sampling_minutes\"] = sampling_minutes\n",
    "\n",
    "    return rv_daily"
   ]
