    "# ------------------------------------------------------------\n",
    "# 3. Check missing minute observations before forward-filling\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "def missing_minutes_one_day(group):\n",
    "    \"\"\"\n",
    "    Count missing minute observations within one trading day.\n",
    "\n",
    "    The expected grid is defined from the first observed timestamp\n",
    "    to the last observed timestamp for that specific day.\n",
    "    \n",
    "    This avoids accidentally including overnight or pre-market periods.\n",
    "    \"\"\"\n",
    "    \n",
    "    # Complete one-minute grid for this trading day\n",
    "    full_grid = pd.date_range(\n",
    "        start=group[\"ts\"].min(),\n",
    "        end=group[\"ts\"].max(),\n",
    "        freq=\"1min\"\n",
    "    )\n",
    "\n",
    "    # Observed timestamps in the original data\n",
    "    observed_minutes = group[\"ts\"].drop_duplicates()\n",
    "\n",
    "    # Count missing observations\n",
    "    expected_minutes = len(full_grid)\n",
    "    observed_minutes_count = observed_minutes.nunique()\n",
    "    missing_minutes = expected_minutes - observed_minutes_count\n",
    "    missing_share = missing_minutes / expected_minutes\n",
    "\n",
    "    return pd.Series({\n",
    "        \"first_timestamp\": group[\"ts\"].min(),\n",
    "        \"last_timestamp\": group[\"ts\"].max(),\n",
    "        \"expected_minutes\": expected_minutes,\n",
    "        \"observed_minutes\": observed_minutes_count,\n",
    "        \"missing_minutes\": missing_minutes,\n",
    "        \"missing_share\": missing_share\n",
    "    })\n",
    "\n",
    "\n",
    "# Apply missing-data check day by day\n",
    "aapl_missing_by_day = (\n",
    "    aapl_raw\n",
    "    .groupby(\"trading_day\")\n",
    "    .apply(missing_minutes_one_day)\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "print(\"Missing-data check for AAPL:\")\n",
    "print(aapl_missing_by_day.head())\n",
    "\n",
    "print(\"\\nSummary of missing minute observations:\")\n",
    "print(\n",
    "    aapl_missing_by_day[\n",
    "        [\"expected_minutes\", \"observed_minutes\", \"missing_minutes\", \"missing_share\"]\n",
    "    ].describe()\n",
    ")\n",
    "\n",
    "# Overall missing share across all AAPL trading days\n",
    "overall_missing_share = (\n",
    "    aapl_missing_by_day[\"missing_minutes\"].sum()\n",
    "    / aapl_missing_by_day[\"expected_minutes\"].sum()\n",
    ")\n",
    "\n",
    "print(\"\\nOverall missing share for AAPL:\")\n",
