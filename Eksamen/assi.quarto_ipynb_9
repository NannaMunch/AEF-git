    "# ------------------------------------------------------------\n",
    "# 6. Compute realized variance for all required sampling intervals\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "# Sampling intervals required in the exam question\n",
    "sampling_intervals = [1, 2, 5, 10, 15, 30, 60]\n",
    "\n",
    "# Compute daily realized variance for each interval and stack results\n",
    "rv_all = pd.concat(\n",
    "    [\n",
    "        compute_daily_rv(aapl_minute, interval)\n",
    "        for interval in sampling_intervals\n",
    "    ],\n",
    "    ignore_index=True\n",
