    "# ------------------------------------------------------------\n",
    "# 4. Create regular one-minute grid and forward-fill missing prices\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "def complete_one_day(group):\n",
    "    \"\"\"\n",
    "    Create a complete one-minute grid for one trading day\n",
    "    and forward-fill missing prices within the same day.\n",
    "\n",
    "    Important:\n",
    "    Prices are only carried forward within the same trading day.\n",
    "    We do not carry prices across trading days.\n",
    "    \"\"\"\n",
    "    \n",
    "    # Sort observations within the day\n",
    "    group = group.sort_values(\"ts\").copy()\n",
    "\n",
    "    # Create complete one-minute timestamp grid from first to last timestamp\n",
    "    full_index = pd.date_range(\n",
    "        start=group[\"ts\"].min(),\n",
    "        end=group[\"ts\"].max(),\n",
    "        freq=\"1min\"\n",
    "    )\n",
    "\n",
    "    # Reindex the day to the complete one-minute grid\n",
    "    group = group.set_index(\"ts\").reindex(full_index)\n",
    "    group.index.name = \"ts\"\n",
    "\n",
    "    # Reconstruct columns after reindexing\n",
    "    group[\"symbol\"] = \"AAPL\"\n",
    "    group[\"trading_day\"] = group.index.date\n",
    "\n",
    "    # Forward-fill price within the day\n",
    "    # If a minute has no observation, we use the most recent available price\n",
    "    group[\"price\"] = group[\"price\"].ffill()\n",
    "\n",
    "    # Recompute log price after filling\n",
    "    group[\"log_price\"] = np.log(group[\"price\"])\n",
    "\n",
    "    return group.reset_index()\n",
    "\n",
    "\n",
    "# Apply forward-fill procedure to each trading day separately\n",
    "aapl_minute = (\n",
    "    aapl_raw\n",
    "    .groupby(\"trading_day\", group_keys=False)\n",
    "    .apply(complete_one_day)\n",
    "    .dropna(subset=[\"price\"])\n",
    "    .sort_values([\"trading_day\", \"ts\"])\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "print(\"AAPL data after constructing regular one-minute grid:\")\n",
    "print(aapl_minute.head())\n",
    "\n",
    "print(\"\\nNumber of rows before filling:\")\n",
    "print(len(aapl_raw))\n",
    "\n",
    "print(\"\\nNumber of rows after filling:\")\n",
    "print(len(aapl_minute))\n",
    "\n",
    "# Check number of minute observations after filling\n",
    "minute_check = (\n",
    "    aapl_minute\n",
    "    .groupby(\"trading_day\")\n",
    "    .size()\n",
    "    .rename(\"n_minutes_after_fill\")\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "print(\"\\nMinutes per trading day after forward-fill:\")\n",
    "print(minute_check[\"n_minutes_after_fill\"].describe())"
