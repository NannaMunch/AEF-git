        "# ------------------------------------------------------------\n",
        "# 5. Compute realized variance for all required intervals\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "sampling_intervals = [1, 2, 5, 10, 15, 30, 60]\n",
        "\n",
        "rv_all = pd.concat(\n",
        "    [compute_daily_rv(aapl_minute, interval) for interval in sampling_intervals],\n",
        "    ignore_index=True\n",
        ")\n",
        "\n",
        "print(rv_all.head())"
      ],
      "id": "6af804fa",
