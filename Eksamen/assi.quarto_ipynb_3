        "# Load data\n",
        "hf_prices = pd.read_parquet(\"hf_minute_prices.parquet\")\n",
        "\n",
        "# Prepare timestamps\n",
        "hf_prices[\"ts\"] = pd.to_datetime(hf_prices[\"ts\"])\n",
        "hf_prices[\"trading_day\"] = hf_prices[\"ts\"].dt.date\n",
        "\n",
        "# Keep AAPL\n",
        "aapl_raw = (\n",
        "    hf_prices\n",
        "    .query(\"symbol == 'AAPL'\")\n",
        "    .sort_values([\"trading_day\", \"ts\"])\n",
        "    .copy()\n",
        ")\n",
        "\n",
        "def missing_minutes_one_day(group):\n",
        "    \"\"\"\n",
        "    Counts how many minute timestamps are missing within one trading day.\n",
        "    Expected minutes are defined from the first to the last observed timestamp that day.\n",
        "    \"\"\"\n",
        "    full_grid = pd.date_range(\n",
        "        start=group[\"ts\"].min(),\n",
        "        end=group[\"ts\"].max(),\n",
        "        freq=\"1min\"\n",
        "    )\n",
        "    \n",
        "    observed_minutes = group[\"ts\"].drop_duplicates()\n",
        "    \n",
        "    return pd.Series({\n",
        "        \"first_timestamp\": group[\"ts\"].min(),\n",
        "        \"last_timestamp\": group[\"ts\"].max(),\n",
        "        \"expected_minutes\": len(full_grid),\n",
        "        \"observed_minutes\": observed_minutes.nunique(),\n",
        "        \"missing_minutes\": len(full_grid) - observed_minutes.nunique(),\n",
        "        \"missing_share\": (len(full_grid) - observed_minutes.nunique()) / len(full_grid)\n",
        "    })\n",
        "\n",
        "aapl_missing_by_day = (\n",
        "    aapl_raw\n",
        "    .groupby(\"trading_day\")\n",
        "    .apply(missing_minutes_one_day)\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "print(aapl_missing_by_day.head())\n",
        "print(aapl_missing_by_day[[\"expected_minutes\", \"observed_minutes\", \"missing_minutes\", \"missing_share\"]].describe())"
      ],
      "id": "bd7a0327",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# ------------------------------------------------------------\n",
        "# 3. Create a regular one-minute grid within each trading day\n",
        "#    and forward-fill missing prices within the same day\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def complete_one_day(group):\n",
        "    \"\"\"\n",
        "    Creates a complete one-minute grid for one trading day\n",
        "    and forward-fills the most recent observed price.\n",
        "    \"\"\"\n",
        "    group = group.sort_values(\"ts\").copy()\n",
        "    \n",
        "    full_index = pd.date_range(\n",
        "        start=group[\"ts\"].min(),\n",
        "        end=group[\"ts\"].max(),\n",
        "        freq=\"1min\"\n",
        "    )\n",
        "    \n",
        "    group = group.set_index(\"ts\").reindex(full_index)\n",
        "    group.index.name = \"ts\"\n",
        "    \n",
        "    group[\"symbol\"] = \"AAPL\"\n",
        "    group[\"trading_day\"] = group.index.date\n",
        "    group[\"price\"] = group[\"price\"].ffill()\n",
        "    group[\"log_price\"] = np.log(group[\"price\"])\n",
        "    \n",
        "    return group.reset_index()\n",
        "\n",
        "\n",
        "aapl_minute = (\n",
        "    aapl_raw\n",
        "    .groupby(\"trading_day\", group_keys=False)\n",
        "    .apply(complete_one_day)\n",
        "    .dropna(subset=[\"price\"])\n",
        "    .sort_values([\"trading_day\", \"ts\"])\n",
        "    .reset_index(drop=True)\n",
        ")\n",
        "\n",
        "# Check after filling\n",
        "minute_check = (\n",
        "    aapl_minute\n",
        "    .groupby(\"trading_day\")\n",
        "    .size()\n",
        "    .rename(\"n_minutes_after_fill\")\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "print(minute_check[\"n_minutes_after_fill\"].describe())"
      ],
