    "# ------------------------------------------------------------\n",
    "# 4. Function to compute daily realized variance\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "def compute_daily_rv(data, sampling_minutes):\n",
    "    \"\"\"\n",
    "    Computes daily realized variance for a given sampling interval.\n",
    "    \n",
    "    Parameters\n",
    "    ----------\n",
    "    data : pandas DataFrame\n",
    "        Must contain trading_day, ts, and log_price.\n",
    "    sampling_minutes : int\n",
    "        Sampling interval in minutes, e.g. 1, 5, 10.\n",
    "    \n",
    "    Returns\n",
    "    -------\n",
    "    pandas DataFrame\n",
    "        Daily realized variance for each trading day.\n",
    "    \"\"\"\n",
    "    \n",
    "    sampled = (\n",
    "        data\n",
    "        .sort_values([\"trading_day\", \"ts\"])\n",
    "        .copy()\n",
    "    )\n",
    "    \n",
    "    # Observation number within each trading day\n",
    "    sampled[\"obs_number\"] = sampled.groupby(\"trading_day\").cumcount()\n",
    "    \n",
    "    # Keep every sampling_minutes-th observation\n",
    "    sampled = sampled[\n",
    "        sampled[\"obs_number\"] % sampling_minutes == 0\n",
    "    ].copy()\n",
    "    \n",
    "    # Intraday log returns within each trading day\n",
    "    sampled[\"intraday_return\"] = (\n",
    "        sampled\n",
    "        .groupby(\"trading_day\")[\"log_price\"]\n",
    "        .diff()\n",
    "    )\n",
    "    \n",
    "    # Realized variance = sum of squared intraday returns\n",
    "    rv_daily = (\n",
    "        sampled\n",
    "        .groupby(\"trading_day\")\n",
    "        .agg(\n",
    "            realized_variance=(\"intraday_return\", lambda x: np.nansum(x ** 2)),\n",
    "            n_returns=(\"intraday_return\", lambda x: x.notna().sum())\n",
    "        )\n",
    "        .reset_index()\n",
    "    )\n",
    "    \n",
    "    rv_daily[\"sampling_minutes\"] = sampling_minutes\n",
    "    \n",
    "    return rv_daily"
   ]
