    "# ------------------------------------------------------------\n",
    "# 3. Create a regular one-minute grid within each trading day\n",
    "#    and forward-fill missing prices within the same day\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "def complete_one_day(group):\n",
    "    \"\"\"\n",
    "    Creates a complete one-minute grid for one trading day\n",
    "    and forward-fills the most recent observed price.\n",
    "    \"\"\"\n",
    "    group = group.sort_values(\"ts\").copy()\n",
    "    \n",
    "    full_index = pd.date_range(\n",
    "        start=group[\"ts\"].min(),\n",
    "        end=group[\"ts\"].max(),\n",
    "        freq=\"1min\"\n",
    "    )\n",
    "    \n",
    "    group = group.set_index(\"ts\").reindex(full_index)\n",
    "    group.index.name = \"ts\"\n",
    "    \n",
    "    group[\"symbol\"] = \"AAPL\"\n",
    "    group[\"trading_day\"] = group.index.date\n",
    "    group[\"price\"] = group[\"price\"].ffill()\n",
    "    group[\"log_price\"] = np.log(group[\"price\"])\n",
    "    \n",
    "    return group.reset_index()\n",
    "\n",
    "\n",
    "aapl_minute = (\n",
    "    aapl_raw\n",
    "    .groupby(\"trading_day\", group_keys=False)\n",
    "    .apply(complete_one_day)\n",
    "    .dropna(subset=[\"price\"])\n",
    "    .sort_values([\"trading_day\", \"ts\"])\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "# Check after filling\n",
    "minute_check = (\n",
    "    aapl_minute\n",
    "    .groupby(\"trading_day\")\n",
    "    .size()\n",
    "    .rename(\"n_minutes_after_fill\")\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "print(minute_check[\"n_minutes_after_fill\"].describe())"
   ]
  },
