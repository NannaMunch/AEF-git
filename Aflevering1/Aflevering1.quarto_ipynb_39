      "source": [
        "#| label: ex6-helper-functions\n",
        "\n",
        "def evaluate_portfolio(weights, mu_true, Sigma_true):\n",
        "    portfolio_mean = weights @ mu_true\n",
        "    portfolio_variance = weights @ Sigma_true @ weights\n",
        "    portfolio_volatility = np.sqrt(portfolio_variance)\n",
        "    portfolio_sharpe = portfolio_mean / portfolio_volatility\n",
        "\n",
        "    return {\n",
