      "source": [
        "#| label: ex5-frontiers-by-sample-size\n",
        "\n",
        "sample_sizes = [60, 120, 500]\n",
        "n_replications = 20\n",
        "\n",
        "frontier_list = []\n",
        "\n",
        "for T in sample_sizes:\n",
        "    for rep in range(n_replications):\n",
        "\n",
        "        simulated_returns = simulate_returns(T, mu, Sigma)\n",
        "\n",
        "        mu_hat = simulated_returns.mean(axis=0)\n",
        "        Sigma_hat = np.cov(simulated_returns, rowvar=False, ddof=1)\n",
        "\n",
        "        frontier_hat = compute_efficient_frontier(\n",
        "            mu_hat,\n",
        "            Sigma_hat,\n",
        "            n_points=100\n",
        "        )\n",
        "\n",
        "        frontier_hat[\"T\"] = f\"T = {T}\"\n",
        "        frontier_hat[\"replication\"] = rep\n",
        "\n",
        "        frontier_list.append(frontier_hat)\n",
        "\n",
        "frontier_replications = pd.concat(frontier_list, ignore_index=True)\n",
        "\n",
        "frontier_true_plot = pd.concat(\n",
