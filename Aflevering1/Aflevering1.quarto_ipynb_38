      "source": [
        "#| label: ex2-synthetic-assets\n",
        "\n",
        "N = 50\n",
        "\n",
        "beta = np.random.uniform(0.5, 1.5, N)\n",
        "sigma_epsilon = np.random.uniform(\n",
        "    0.10 / np.sqrt(12),\n",
        "    0.30 / np.sqrt(12),\n",
        "    N\n",
        ")\n",
        "\n",
        "mu = beta * mu_m\n",
        "Sigma = sigma2_m * np.outer(beta, beta) + np.diag(sigma_epsilon**2)\n",
        "asset_points = pd.DataFrame({\n",
        "    \"volatility\": np.sqrt(np.diag(Sigma)),\n",
        "    \"return\": mu\n",
        "})"
