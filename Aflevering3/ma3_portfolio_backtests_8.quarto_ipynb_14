    "ROLLING_WINDOW = 36\n",
    "MIN_OBS_FRAC   = 0.70\n",
    "\n",
    "def regularise_by_eigenvalue_floor(Sigma_raw, floor_frac=0.10):\n",
    "    eigval, eigvec = np.linalg.eigh(Sigma_raw)\n",
    "    eigval_floored = np.clip(eigval, floor_frac * eigval.max(), None)\n",
    "    Sigma_reg = eigvec @ np.diag(eigval_floored) @ eigvec.T\n",
    "    return (Sigma_reg + Sigma_reg.T) / 2"
