    "GAMMA = 4  # risk aversion, fixed throughout the assignment\n",
    "\n",
    "def compute_weights(mu, Sigma, gamma, lam, w_prev):\n",
    "    N = len(mu)\n",
    "    alpha = gamma / (gamma + 2 * lam)\n",
    "    Sigma_inv = np.linalg.pinv(Sigma)\n",
    "    iota = np.ones(N)\n",
    "    iota_Sinv = Sigma_inv @ iota\n",
    "    denom = iota @ iota_Sinv\n",
    "    w_gmv = iota_Sinv / denom\n",
    "    A_mu = Sigma_inv @ mu - (iota_Sinv @ mu / denom) * iota_Sinv\n",
    "    w_mv = (1.0 / gamma) * A_mu + w_gmv\n",
    "    w_star = alpha * w_mv + (1.0 - alpha) * w_prev\n",
    "    w_star = np.clip(w_star, -3.0, 3.0)\n",
    "    denom_w = w_star.sum()\n",
    "    return w_star / denom_w if abs(denom_w) > 1e-6 else np.ones(N) / N\n",
    "\n",
    "\n",
    "def compute_weights_no_short(mu, Sigma, gamma, lam, w_prev):\n",
    "    N = len(mu)\n",
    "    scale = gamma + 2 * lam\n",
    "    mu_eff = mu + 2 * lam * (Sigma @ w_prev)\n",
    "    objective = lambda w: 0.5 * scale * w @ Sigma @ w - mu_eff @ w\n",
    "    gradient  = lambda w: scale * Sigma @ w - mu_eff\n",
    "    constraints = [{\"type\": \"eq\", \"fun\": lambda w: w.sum() - 1}]\n",
    "    bounds = [(0.0, 1.0)] * N\n",
    "    w0 = np.ones(N) / N\n",
    "    result = minimize(objective, w0, jac=gradient, method=\"SLSQP\",\n",
    "                       bounds=bounds, constraints=constraints,\n",
    "                       options={\"ftol\": 1e-9, \"maxiter\": 500})\n",
    "    if result.success:\n",
    "        w = np.clip(result.x, 0, None)\n",
    "        return w / w.sum()\n",
    "    return w0\n",
    "\n",
    "# Sanity check on a small, well-conditioned toy problem\n",
    "np.random.seed(0)\n",
    "N_test = 5\n",
    "mu_test = np.random.randn(N_test) * 0.01\n",
    "S_test = np.eye(N_test) * 0.04\n",
    "w_prev_test = np.ones(N_test) / N_test\n",
    "w_test = compute_weights(mu_test, S_test, GAMMA, 0.1, w_prev_test)"
