    "\n",
    "# Optional objects for inline reporting in the text\n",
    "ml_month_share = ml_months / len(oos_dates)\n",
    "\n",
    "if ml_cov:\n",
    "    avg_ml_coverage = np.mean(ml_cov)\n",
    "else:\n",
    "    avg_ml_coverage = np.nan"
