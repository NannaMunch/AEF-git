   "source": [
    "strategies = [\"naive\", \"tc_mv\", \"tc_mv_lw\", \"mv_noshort\"]\n",
    "results = {s: {\"ret\": [], \"turnover\": [], \"dates\": []} for s in strategies}\n",
    "w_prev = {s: None for s in strategies}\n",
    "\n",
    "# Optional: used to report MA2 prediction coverage in the text\n",
    "ml_months = 0\n",
    "ml_cov = []\n",
    "\n",
    "# Faster lookup of previous out-of-sample month\n",
    "date_to_pos = {date: i for i, date in enumerate(oos_dates)}\n",
    "\n",
    "\n",
    "def compute_turnover(w_new, w_pre):\n",
    "    \"\"\"\n",
    "    Turnover is the L1 distance between the newly chosen weights and the\n",
    "    pre-rebalancing weights after last month's portfolio has drifted.\n",
    "    \"\"\"\n",
    "    return np.sum(np.abs(w_new - w_pre))\n",
    "\n",
    "\n",
    "def get_w_prev(strategy, permnos, date):\n",
    "    \"\"\"\n",
    "    Return the pre-rebalancing weights for the current month.\n",
    "\n",
    "    The previous portfolio is first aligned to the current universe and then\n",
    "    drifted forward using last month's realised returns.\n",
    "    \"\"\"\n",
    "    if w_prev[strategy] is None:\n",
    "        return np.ones(len(permnos)) / len(permnos)\n",
    "\n",
    "    prev_w_series, prev_permnos = w_prev[strategy]\n",
    "    prev_dict = dict(zip(prev_permnos, prev_w_series))\n",
    "\n",
    "    # Align previous weights to the current universe\n",
    "    w_arr = np.array([prev_dict.get(p, 0.0) for p in permnos])\n",
    "\n",
    "    # Drift previous weights using last month's realised returns\n",
    "    prev_date_idx = date_to_pos[date] - 1\n",
    "\n",
    "    if prev_date_idx >= 0:\n",
    "        prev_date = oos_dates[prev_date_idx]\n",
    "        prev_ret = ret_panel.loc[prev_date, permnos].fillna(0).values\n",
    "\n",
    "        gross = w_arr * (1 + prev_ret)\n",
    "\n",
    "        if gross.sum() > 0:\n",
    "            w_arr = gross / gross.sum()\n",
    "\n",
    "    # Normalise or fall back to equal weights if there is no overlap\n",
    "    if w_arr.sum() > 0:\n",
    "        w_arr = w_arr / w_arr.sum()\n",
    "    else:\n",
    "        w_arr = np.ones(len(permnos)) / len(permnos)\n",
    "\n",
    "    return w_arr\n",
    "\n",
    "\n",
    "for t_idx, date in enumerate(oos_dates):\n",
    "\n",
    "    oos_ret = ret_panel.loc[date]\n",
    "    valid_permnos = oos_ret.dropna().index.tolist()\n",
    "\n",
    "    if len(valid_permnos) < 30:\n",
    "        continue\n",
    "\n",
    "    window_end = ret_panel.index[ret_panel.index < date]\n",
    "\n",
    "    if len(window_end) < ROLLING_WINDOW:\n",
    "        continue\n",
    "\n",
    "    window_start = window_end[-ROLLING_WINDOW]\n",
    "    ret_window_full = ret_panel.loc[window_start:window_end[-1], valid_permnos]\n",
    "\n",
    "    min_obs = int(MIN_OBS_FRAC * ROLLING_WINDOW)\n",
    "    ret_window = ret_window_full.dropna(axis=1, thresh=min_obs)\n",
    "    permnos_w = ret_window.columns.tolist()\n",
    "\n",
    "    if len(permnos_w) < 20:\n",
    "        continue\n",
    "\n",
    "    N_w = len(permnos_w)\n",
    "\n",
    "    ret_w_filled = ret_window.fillna(ret_window.mean(axis=0))\n",
    "    X = ret_w_filled.values\n",
    "\n",
    "    excess_window = excess_panel.loc[window_start:window_end[-1], permnos_w]\n",
    "    excess_w_filled = excess_window.fillna(excess_window.mean(axis=0))\n",
    "\n",
    "    Sigma_sample = regularise_by_eigenvalue_floor(np.cov(X, rowvar=False))\n",
    "\n",
    "    lw_est = LedoitWolf()\n",
    "    lw_est.fit(X)\n",
    "    Sigma_lw = lw_est.covariance_\n",
    "\n",
    "    ml_mu = get_ml_predicted_returns(date, permnos_w)\n",
    "\n",
    "    if ml_mu is not None:\n",
    "        aligned = ml_mu.reindex(permnos_w)\n",
    "        ml_months += 1\n",
    "        ml_cov.append(aligned.notna().mean())\n",
    "\n",
    "        mu_vec = aligned.fillna(ml_mu.mean()).values\n",
    "\n",
    "    else:\n",
    "        mu_series = excess_w_filled.mean(axis=0)\n",
    "        lo, hi = mu_series.quantile(0.01), mu_series.quantile(0.99)\n",
    "        mu_vec = MU_SHRINK * mu_series.clip(lo, hi).values\n",
    "\n",
    "    realized_ret = oos_ret.reindex(permnos_w).fillna(0).values\n",
    "\n",
    "    # Pre-rebalancing weights\n",
    "    w0_naive = get_w_prev(\"naive\", permnos_w, date)\n",
    "    w0_mv = get_w_prev(\"tc_mv\", permnos_w, date)\n",
    "    w0_lw = get_w_prev(\"tc_mv_lw\", permnos_w, date)\n",
    "    w0_ns = get_w_prev(\"mv_noshort\", permnos_w, date)\n",
    "\n",
    "    # New portfolio weights\n",
    "    w_naive = np.ones(N_w) / N_w\n",
    "    w_mv = compute_weights(mu_vec, Sigma_sample, GAMMA, LAMBDA, w0_mv)\n",
    "    w_mv_lw = compute_weights(mu_vec, Sigma_lw, GAMMA, LAMBDA, w0_lw)\n",
    "    w_ns = compute_weights_no_short(mu_vec, Sigma_lw, GAMMA, LAMBDA, w0_ns)\n",
    "\n",
    "    for strat, w_new, w_pre in [\n",
    "        (\"naive\", w_naive, w0_naive),\n",
    "        (\"tc_mv\", w_mv, w0_mv),\n",
    "        (\"tc_mv_lw\", w_mv_lw, w0_lw),\n",
    "        (\"mv_noshort\", w_ns, w0_ns),\n",
    "    ]:\n",
    "        port_ret = w_new @ realized_ret\n",
    "        turnover = compute_turnover(w_new, w_pre)\n",
