    "\n",
    "Sigma_s = regularise_by_eigenvalue_floor(np.cov(X_comp, rowvar=False))\n",
    "\n",
    "lw_c = LedoitWolf()\n",
    "lw_c.fit(X_comp)\n",
    "Sigma_lw_c = lw_c.covariance_\n",
    "\n",
    "def gmv_weights(Sigma):\n",
    "    N = Sigma.shape[0]\n",
    "    Si = np.linalg.pinv(Sigma)\n",
    "    iota = np.ones(N)\n",
    "    return Si @ iota / (iota @ Si @ iota)\n",
