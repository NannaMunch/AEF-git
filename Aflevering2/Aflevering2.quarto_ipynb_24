   "source": [
    "def assign_deciles(df, pred_col, decile_col):\n",
    "    \"\"\"\n",
    "    Assign stocks to decile portfolios each month based on predicted returns.\n",
    "    Uses ranked predictions to avoid qcut dropping bins when many values are tied.\n",
    "    \"\"\"\n",
    "    df = df.copy()\n",
    "\n",
    "    def month_deciles(x):\n",
    "        if x.notna().sum() < 10:\n",
    "            return pd.Series(np.nan, index=x.index)\n",
    "\n",
    "        ranked = x.rank(method=\"first\")\n",
    "        return pd.qcut(ranked, 10, labels=False)\n",
    "\n",
    "    df[decile_col] = df.groupby(\"date\")[pred_col].transform(month_deciles)\n",
    "    df[decile_col] = pd.to_numeric(df[decile_col], errors=\"coerce\")\n",
    "\n",
    "    return df\n",
    "\n",
    "meta_val = assign_deciles(meta_val, \"pred_en\", \"decile_en\")\n",
    "meta_val = assign_deciles(meta_val, \"pred_rf\", \"decile_rf\")\n",
    "\n",
    "meta_test = assign_deciles(meta_test, \"pred_en\", \"decile_en\")\n",
    "meta_test = assign_deciles(meta_test, \"pred_rf\", \"decile_rf\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "2160c13f",
   "metadata": {},
   "source": [
    "The long-short strategy buys the top predicted-return decile and shorts the bottom predicted-return decile. The monthly long-short return is therefore the value-weighted return of decile 9 minus the value-weighted return of decile 0."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "6c9d6de7",
   "metadata": {},
   "outputs": [],
   "source": [
    "#| output: false\n",
    "\n",
    "def compute_longshort(df, decile_col):\n",
    "    \"\"\"\n",
    "    Compute monthly value-weighted long-short portfolio returns.\n",
    "    Long = top decile (9), Short = bottom decile (0).\n",
    "    Skips months where one of the legs is missing.\n",
    "    \"\"\"\n",
    "    results = []\n",
    "\n",
    "    for date, group in df.groupby(\"date\"):\n",
    "        group = group.dropna(subset=[decile_col, \"ret_excess\", \"mktcap_lag\"])\n",
    "\n",
    "        long_leg = group[group[decile_col] == 9]\n",
    "        short_leg = group[group[decile_col] == 0]\n",
    "\n",
    "        if len(long_leg) == 0 or len(short_leg) == 0:\n",
    "            continue\n",
    "\n",
    "        if long_leg[\"mktcap_lag\"].sum() <= 0 or short_leg[\"mktcap_lag\"].sum() <= 0:\n",
    "            continue\n",
    "\n",
    "        long_ret = np.average(long_leg[\"ret_excess\"], weights=long_leg[\"mktcap_lag\"])\n",
    "        short_ret = np.average(short_leg[\"ret_excess\"], weights=short_leg[\"mktcap_lag\"])\n",
    "        ls_ret = long_ret - short_ret\n",
    "\n",
    "        results.append({\n",
    "            \"date\": date,\n",
    "            \"long_ret\": long_ret,\n",
    "            \"short_ret\": short_ret,\n",
    "            \"ls_ret\": ls_ret\n",
    "        })\n",
    "\n",
    "    out = pd.DataFrame(results)\n",
    "\n",
    "    if out.empty:\n",
    "        raise ValueError(\n",
    "            f\"No valid months found for {decile_col}. \"\n",
    "            f\"Check whether both decile 0 and decile 9 exist in each month.\"\n",
    "        )\n",
    "\n",
    "    out[\"date\"] = pd.to_datetime(out[\"date\"])\n",
    "    return out.set_index(\"date\")\n",
    "\n",
    "ls_val_en  = compute_longshort(meta_val,  \"decile_en\")\n",
    "ls_val_rf  = compute_longshort(meta_val,  \"decile_rf\")\n",
    "\n",
    "ls_test_en = compute_longshort(meta_test, \"decile_en\")\n",
    "ls_test_rf = compute_longshort(meta_test, \"decile_rf\")"
   ]
