        "#| echo: false\n",
        "\n",
        "def compute_turnover(df, decile_col):\n",
        "    \"\"\"\n",
        "    Monthly turnover: average fraction of long/short legs that changes each month.\n",
        "    \"\"\"\n",
        "    turnovers = []\n",
        "    dates = sorted(df[\"date\"].unique())\n",
        "\n",
        "    for i in range(1, len(dates)):\n",
        "        prev = df[df[\"date\"] == dates[i-1]]\n",
        "        curr = df[df[\"date\"] == dates[i]]\n",
        "\n",
        "        prev_long  = set(prev[prev[decile_col] == 9.0][\"permno\"])\n",
        "        curr_long  = set(curr[curr[decile_col] == 9.0][\"permno\"])\n",
        "        prev_short = set(prev[prev[decile_col] == 0.0][\"permno\"])\n",
        "        curr_short = set(curr[curr[decile_col] == 0.0][\"permno\"])\n",
        "\n",
        "        long_to  = len(prev_long  - curr_long)  / max(len(prev_long), 1)\n",
        "        short_to = len(prev_short - curr_short) / max(len(prev_short), 1)\n",
        "        turnovers.append((long_to + short_to) / 2)\n",
        "\n",
        "    return np.mean(turnovers)\n",
        "\n",
        "to_val_en  = compute_turnover(meta_val,  \"decile_en\")\n",
        "to_val_rf  = compute_turnover(meta_val,  \"decile_rf\")\n",
        "to_test_en = compute_turnover(meta_test, \"decile_en\")\n",
        "to_test_rf = compute_turnover(meta_test, \"decile_rf\")\n",
        "\n",
        "turnover_df = pd.DataFrame({\n",
        "    \"Model\": [\"Elastic Net\", \"Random Forest\"],\n",
        "    \"Validation\": [to_val_en, to_val_rf],\n",
        "    \"Test\": [to_test_en, to_test_rf]\n",
        "})"
