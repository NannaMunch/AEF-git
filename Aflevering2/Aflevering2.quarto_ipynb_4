      "source": [
        "#| echo: false\n",
        "\n",
        "def portfolio_stats(ls_returns, market_returns=None):\n",
        "    r = ls_returns[\"ls_ret\"]\n",
        "    ann_mean   = r.mean() * 12\n",
        "    ann_sharpe = r.mean() / r.std() * np.sqrt(12)\n",
        "\n",
        "    if market_returns is not None:\n",
        "        aligned = pd.concat([r, market_returns], axis=1).dropna()\n",
        "        aligned.columns = [\"ls_ret\", \"mkt_excess_ret\"]\n",
        "        X_capm = sm.add_constant(aligned[\"mkt_excess_ret\"])\n",
        "        res = sm.OLS(aligned[\"ls_ret\"], X_capm).fit()\n",
        "        alpha   = res.params[\"const\"] * 12\n",
        "        alpha_t = res.tvalues[\"const\"]\n",
        "    else:\n",
        "        alpha, alpha_t = np.nan, np.nan\n",
        "\n",
        "    return {\n",
        "        \"ann_mean\": ann_mean,\n",
        "        \"sharpe\": ann_sharpe,\n",
        "        \"alpha\": alpha,\n",
        "        \"alpha_t\": alpha_t\n",
        "    }\n",
        "\n",
        "# market excess returns\n",
        "mkt_val = meta_val.groupby(\"date\").apply(\n",
        "    lambda g: np.average(g[\"ret_excess\"], weights=g[\"mktcap_lag\"])\n",
        ").rename(\"mkt_excess_ret\")\n",
        "\n",
        "mkt_test = meta_test.groupby(\"date\").apply(\n",
