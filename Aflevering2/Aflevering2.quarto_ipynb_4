      "id": "c176b5f5"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "missing_table = (\n",
        "    df[stock_chars + macro_vars]\n",
        "    .isna()\n",
        "    .sum()\n",
        "    .rename(\"n_missing\")\n",
