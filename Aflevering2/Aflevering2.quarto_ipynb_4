        ").rename(\"mkt_excess_ret\")\n",
        "\n",
        "# collect results\n",
        "results_3d = [\n",
        "    {\"Model\": \"Elastic Net\", \"Sample\": \"Validation\", **portfolio_stats(ls_val_en, mkt_val)},\n",
        "    {\"Model\": \"Random Forest\", \"Sample\": \"Validation\", **portfolio_stats(ls_val_rf, mkt_val)},\n",
        "    {\"Model\": \"Elastic Net\", \"Sample\": \"Test\", **portfolio_stats(ls_test_en, mkt_test)},\n",
        "    {\"Model\": \"Random Forest\", \"Sample\": \"Test\", **portfolio_stats(ls_test_rf, mkt_test)},\n",
        "]\n",
