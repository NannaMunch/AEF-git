   "source": [
    "def recode_sic(sic):\n",
    "    if pd.isna(sic):\n",
    "        return \"Other\"\n",
    "    sic = int(sic)\n",
    "    if sic < 10:\n",
    "        return \"Agriculture\"\n",
    "    elif sic < 15:\n",
    "        return \"Mining\"\n",
    "    elif sic < 18:\n",
    "        return \"Construction\"\n",
    "    elif sic < 40:\n",
    "        return \"Manufacturing\"\n",
    "    elif sic < 50:\n",
    "        return \"Transportation\"\n",
    "    elif sic < 52:\n",
    "        return \"Wholesale\"\n",
    "    elif sic < 60:\n",
    "        return \"Retail\"\n",
    "    elif sic < 70:\n",
    "        return \"Finance\"\n",
    "    elif sic < 90:\n",
    "        return \"Services\"\n",
    "    else:\n",
    "        return \"Public Admin\"\n",
    "\n",
    "df[\"sic_division\"] = df[\"sic2\"].apply(recode_sic)"
   ]
