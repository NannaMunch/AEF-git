      "source": [
        "#| label: fig-tuning-rmse\n",
        "#| fig-cap: Training and validation RMSE across model complexity\n",
        "\n",
        "# Elastic Net: average RMSE by alpha across l1_ratio values\n",
        "en_plot = (\n",
        "    en_results_df\n",
        "    .groupby(\"alpha\")[[\"train_rmse\", \"val_rmse\"]]\n",
        "    .mean()\n",
        "    .reset_index()\n",
        "    .sort_values(\"alpha\")\n",
        ")\n",
        "\n",
        "# Random Forest: RMSE by max_depth\n",
        "rf_plot = (\n",
        "    rf_results_df\n",
        "    .groupby(\"max_depth\")[[\"train_rmse\", \"val_rmse\"]]\n",
        "    .mean()\n",
        "    .reset_index()\n",
        "    .sort_values(\"max_depth\")\n",
