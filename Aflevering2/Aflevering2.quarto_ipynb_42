        "        \"val_rmse\": root_mean_squared_error(y_val, model.predict(X_val))\n",
        "    })\n",
        "\n",
        "rf_results_df = pd.DataFrame(rf_results).sort_values(\"val_rmse\")\n",
        "\n",
        "best_rf_params = rf_results_df.iloc[0][\n",
        "    [\"n_estimators\", \"max_features\", \"min_samples_leaf\", \"max_depth\"]\n",
