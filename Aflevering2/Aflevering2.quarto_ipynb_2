      "source": [
        "# Baseline test Sharpe ratios from Exercise 3d\n",
        "baseline_sharpe_en = ls_test_en[\"ls_ret\"].mean() / ls_test_en[\"ls_ret\"].std() * np.sqrt(12)\n",
        "baseline_sharpe_nn = ls_test_nn[\"ls_ret\"].mean() / ls_test_nn[\"ls_ret\"].std() * np.sqrt(12)\n",
        "\n",
        "# Reference values:\n",
        "# standardized continuous predictors -> 0\n",
        "# industry dummies -> mean in the test set\n",
        "reference_values = {\n",
        "    col: 0.0 if col in continuous_features else X_test[col].mean()\n",
        "    for col in X_test.columns\n",
        "}\n",
        "\n",
        "def variable_importance_sharpe_drop(model, X_test, meta_test, pred_col, decile_col,\n",
        "                                    baseline_sharpe, reference_values):\n",
        "    results = []\n",
        "\n",
        "    for feature in X_test.columns:\n",
        "        X_mod = X_test.copy()\n",
        "        X_mod[feature] = reference_values[feature]\n",
        "\n",
        "        tmp = meta_test.copy()\n",
        "        tmp[pred_col] = model.predict(X_mod)\n",
        "        tmp = assign_deciles(tmp, pred_col, decile_col)\n",
        "\n",
        "        ls_tmp = compute_longshort(tmp, decile_col)\n",
        "        perturbed_sharpe = ls_tmp[\"ls_ret\"].mean() / ls_tmp[\"ls_ret\"].std() * np.sqrt(12)\n",
        "\n",
        "        results.append({\n",
        "            \"feature\": feature,\n",
        "            \"sharpe_drop\": baseline_sharpe - perturbed_sharpe\n",
        "        })\n",
        "\n",
        "    return (\n",
        "        pd.DataFrame(results)\n",
        "        .sort_values(\"sharpe_drop\", ascending=False)\n",
        "        .reset_index(drop=True)\n",
        "    )\n",
        "\n",
        "vi_en = variable_importance_sharpe_drop(\n",
        "    final_en, X_test, meta_test, \"pred_en_vi\", \"decile_en_vi\",\n",
        "    baseline_sharpe_en, reference_values\n",
        ")\n",
        "\n",
        "vi_nn = variable_importance_sharpe_drop(\n",
        "    final_nn, X_test, meta_test, \"pred_nn_vi\", \"decile_nn_vi\",\n",
        "    baseline_sharpe_nn, reference_values\n",
